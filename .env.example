# VeriRAG Configuration
VERIRAG_ENV=development
VERIRAG_LOG_LEVEL=INFO

# Storage
VERIRAG_DATA_DIR=./data
VERIRAG_VECTOR_PATH=./data/vector_store.json
VERIRAG_BM25_PATH=./data/bm25_index.json

# Chunking
VERIRAG_CHUNK_SIZE=512
VERIRAG_CHUNK_OVERLAP=64

# Embeddings ("deterministic", "sentence-transformers", "openai")
VERIRAG_EMBEDDING_PROVIDER=deterministic
VERIRAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
VERIRAG_EMBED_DIM=384

# Hybrid Retrieval & RRF
VERIRAG_TOP_K=5
VERIRAG_RRF_K=60
VERIRAG_HYBRID_ALPHA=0.6
VERIRAG_ENABLE_RERANKING=true

# Hallucination Guardrails
VERIRAG_ENABLE_VERIFICATION=true
VERIRAG_CLAIM_THRESHOLD=0.60
VERIRAG_MAX_HALLUCINATION_INDEX=0.25

# Optional LLM API Keys (Falls back to local extractor if unset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
